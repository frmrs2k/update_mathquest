[sub_resource type="GDScript" id="GDScript_8y302"]
script/source = "extends Control

var character_files = [
	preload(\"res://scene/m_wizard.tscn\"),
	preload(\"res://scene/m_archer.tscn\"),
	preload(\"res://scene/f_wizard.tscn\"),
	preload(\"res://scene/f_archer.tscn\"),
	preload(\"res://scene/warrior.tscn\"),
	preload(\"res://scene/princess.tscn\")
]

@onready var container = $CharacterContainer

# Dito natin i-save kung sino ang napili (para gamitin sa Confirm button)
var selected_character_name = \"\"

func _ready():
	# Kunin laki ng screen
	var screen_size = get_viewport_rect().size
	var center_x = screen_size.x / 2
	var center_y = screen_size.y / 2

	# Grid Settings (I-adjust mo ito kung magkakapatong sila)
	var max_columns = 3
	var x_spacing = 120.0
	var y_spacing = 150.0
	
	var start_x = center_x - x_spacing
	var start_y = center_y - y_spacing

	for i in range(character_files.size()):
		var new_char = character_files[i].instantiate()
		
		var col = i % max_columns 
		var row = int(i / max_columns) 
		
		new_char.position = Vector2(start_x + (col * x_spacing), start_y + (row * y_spacing))
		
		# Ikonekta yung click
		if new_char.has_signal(\"char_clicked\"):
			new_char.char_clicked.connect(_on_character_picked)
		
		container.add_child(new_char)

# Ito ang tatakbo kapag may tinapik na character
func _on_character_picked(char_name):
	selected_character_name = char_name
	print(\"Napili mo si: \", char_name)
	
	# Dito mo ilalagay yung logic para mag-highlight yung napili
	# (Halimbawa: Palitan mo yung kulay ng character)
"

